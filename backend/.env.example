# ============================================================
# ForgeAI backend — copy to .env and adjust
#   cp .env.example .env
# NEVER commit the real .env file.
# ============================================================

# --- Core ---
APP_NAME="ForgeAI API"
ENV=dev                          # dev | prod
DEBUG=true
API_PREFIX=/api

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# PostgreSQL (recommended, used by docker-compose):
DATABASE_URL=postgresql+psycopg2://forgeai:forgeai@localhost:5432/forgeai
# SQLite (zero-setup local dev):
# DATABASE_URL=sqlite:///./forgeai.db

# --- CORS ---
# Comma-separated list of allowed origins. Use "*" only in development.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000

# --- Uploads / storage ---
STORAGE_BACKEND=local            # local | s3 (s3 adapter is a stub, see services/storage.py)
UPLOAD_DIR=uploads
MAX_PHOTO_MB=15
MAX_VIDEO_MB=200

# --- Rate limiting (requests per minute, per IP, per bucket) ---
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=40
RATE_LIMIT_UPLOAD_PER_MIN=20

# --- AI layer ---
# Provider is pluggable (app/services/ai/provider.py). "stub" requires NO API key
# and returns deterministic rule-based results so the whole backend works offline.
AI_PROVIDER=stub
AI_MODEL_NAME=forge-rules
AI_MODEL_VERSION=0.1.0
# Add provider keys here ONLY when you implement a real provider, e.g.:
# OPENAI_API_KEY=

# --- Demo seed data (used by `python -m app.db.seed`) ---
DEMO_USER_EMAIL=demo@forgeai.dev
DEMO_USER_PASSWORD=forgeai-demo
